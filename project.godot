config_version=5

[application]

config/name="Geometry Survival: O Cálculo Final"
config/description="Jogo sério 2D de geometria plana para o Ensino Médio"
config/version="1.4"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0196, 0.0275, 0.0588, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/Settings.gd"
AudioManager="*res://scripts/AudioManager.gd"
ShapeGenerator="*res://scripts/ShapeGenerator.gd"
GameManager="*res://scripts/GameManager.gd"
SaveGame="*res://scripts/SaveGame.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0196, 0.0275, 0.0588, 1)
